{
    "name": "romanpiller/console",
    "description": "Console with Symfony",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Roman Piller",
            "email": "roman.piller@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Console\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Console\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/romanpiller/demo.git"
        }
    ],
    "require": {
        "php": "^8.2",
        "nette/di": "^3.2",
        "psr/log": "^3.0",
        "romanpiller/demo":"^1.0.1",
        "symfony/console": "^8.1"
    },
    "require-dev": {
        "nette/tester": "^2.4.3",
        "phpstan/phpstan": "^1.9.18",
        "roave/security-advisories": "dev-latest",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "scripts": {
        "check-dependency": "vendor/bin/composer-dependency-analyser --config tests/dependencies/composer-dependency-analyser.php",
        "phpstan": "php -dxdebug.mode=off vendor/bin/phpstan analyse -c tests/phpstan/phpstan.neon",
        "phpstan-new": "git diff devel --name-only --diff-filter=dr | xargs php -dxdebug.mode=off vendor/bin/phpstan analyse -c tests/phpstan/phpstan.neon",
        "phpstan-baseline": "php -dxdebug.mode=off vendor/bin/phpstan analyse -c tests/phpstan.neon app/ tests/ --generate-baseline tests/phpstan-baseline.neon --allow-empty-baseline",
        "phpcodesniffer": "vendor/bin/phpcs -p -s --colors app/ tests/ --extensions=php,phpt --standard=PSR1,PSR2,PSR12 --exclude=PSR1.Files.SideEffects,PSR12.Files.OpenTag,PSR12.Files.FileHeader ",
        "phpcodesniffer-new": "git diff devel --name-only --diff-filter=dr | xargs vendor/bin/phpcs -p -s --colors --standard=PSR1,PSR2,PSR12 --exclude=PSR1.Files.SideEffects,PSR12.Files.OpenTag,PSR12.Files.FileHeader",
        "unit": "vendor/bin/tester -o console -C -s tests",
        "cover": "vendor/bin/tester -C tests --coverage-src app/ --coverage tests/cover.html",
        "check-new": ["@phpstan-new", "@phpcodesniffer-new"],
        "check-all": ["@check-dependency", "@phpstan", "@phpcodesniffer", "@unit"]
    }
}
